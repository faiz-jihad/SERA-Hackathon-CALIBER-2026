# =====================================================================
# SERA (System for Equipment Reliability Assessment)
# Production Environment Configuration
# =====================================================================

# Environment mode: 'production' or 'development'
SERA_ENV=production

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# For Docker / Production PostgreSQL:
DATABASE_URL=postgresql://sera_user:sera_pass@localhost:5432/sera_db
# For SQLite (Local Workstation Standalone):
# DATABASE_URL=sqlite:///./sera.db

# PostgreSQL Container Credentials (used by docker-compose)
POSTGRES_USER=sera_user
POSTGRES_PASSWORD=sera_pass
POSTGRES_DB=sera_db

# ---------------------------------------------------------------------
# Network & Security (Purdue Model Level 3 / Plant Intranet)
# ---------------------------------------------------------------------
# Comma-separated list of allowed origins or IP addresses for CORS
ALLOWED_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Backend Port
PORT=8000

# ---------------------------------------------------------------------
# AI / Reasoning Engine Configuration
# ---------------------------------------------------------------------
# SERA is 100% functional offline without internet using its deterministic
# engineering rules engine (ISO 10816 & FFT spectral analysis).
# Optional local LLM via Ollama for natural language report synthesis:
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
AI_FALLBACK_MODE=rule_based
